{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.activemirror.ai/schemas/mirrorproof.chetana.assessment.v0.1.json",
  "title": "Chetana MirrorProof Assessment Receipt v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "issued_at_utc",
    "issuer",
    "evidence",
    "assessment",
    "provenance",
    "scope",
    "lineage",
    "receipt_hash",
    "signature_base64url"
  ],
  "properties": {
    "schema_version": { "const": "mirrorproof.chetana.assessment.v0.1" },
    "receipt_id": { "type": "string", "pattern": "^mpr_[0-9a-f]{32}$" },
    "issued_at_utc": { "type": "string", "format": "date-time" },
    "issuer": { "type": "object" },
    "evidence": { "type": "object" },
    "assessment": { "type": "object" },
    "provenance": { "type": "object" },
    "scope": { "type": "object" },
    "lineage": { "type": "object" },
    "receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature_base64url": { "type": "string" }
  },
  "additionalProperties": false
}
